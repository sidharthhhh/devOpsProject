# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_this_strong_password
MYSQL_DATABASE=chatdb

# JWT
JWT_SECRET=generate-a-64-char-random-string-here

# Server
GRPC_PORT=50051
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800

# Frontend (set in docker-compose)
NEXT_PUBLIC_WS_URL=ws://your-domain.com/ws
GRPC_HOST=backend:50051
